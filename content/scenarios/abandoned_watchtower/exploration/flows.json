{
  "flows": [
    {
      "id": "closed_gate_flow",
      "challenge_id": "closed_gate",
      "nodes": [
        {
          "id": "gate_blocked",
          "label": "Brama nadal blokuje drogę",
          "active_when": {
            "no_flags": ["gate_passed"]
          }
        },
        {
          "id": "lock_closed",
          "label": "Zamek pozostaje zamknięty",
          "active_when": {
            "no_flags": ["gate_lock_cleared", "gate_passed"]
          }
        },
        {
          "id": "bolt_exposed",
          "label": "Otwarty zamek odsłania problem rygla",
          "active_when": {
            "all_flags": ["gate_lock_cleared"],
            "no_flags": ["gate_bolt_cleared", "gate_passed"]
          }
        },
        {
          "id": "wall_route_known",
          "label": "Drużyna zna obejście przez mur",
          "active_when": {
            "all_flags": ["gate_wall_route_found"],
            "no_flags": ["gate_bypass_open", "gate_passed"]
          }
        },
        {
          "id": "gate_passed",
          "label": "Droga na dziedziniec jest otwarta",
          "active_when": {
            "all_flags": ["gate_passed"]
          },
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "force_gate",
          "goal_id": "force_entry",
          "from": ["gate_blocked"],
          "route_kind": "challenge_option",
          "route_ref": "force_gate"
        },
        {
          "id": "open_gate_lock",
          "goal_id": "open_lock",
          "from": ["lock_closed"],
          "route_kind": "challenge_option",
          "route_ref": "lockpick_gate"
        },
        {
          "id": "survey_gate",
          "goal_id": "look_around",
          "from": ["gate_blocked"],
          "route_kind": "observation_router",
          "observation_ids": [
            "survey_gate_surroundings",
            "search_gate_alternate_route",
            "inspect_gate_hinges",
            "search_gate_cutting_tool",
            "search_gate_traps",
            "look_through_gate_gap"
          ],
          "default_observation_id": "survey_gate_surroundings"
        },
        {
          "id": "remove_gate_bolt",
          "goal_id": "remove_bolt",
          "from": ["bolt_exposed"],
          "route_kind": "challenge_option",
          "route_ref": "remove_gate_bolt",
          "source_action_ids": ["pry_bolt_with_plank"]
        },
        {
          "id": "use_wall_route",
          "goal_id": "use_wall_route",
          "from": ["wall_route_known"],
          "route_kind": "challenge_option",
          "route_ref": "find_way_around"
        }
      ]
    },
    {
      "id": "courtyard_search_flow",
      "challenge_id": "courtyard_search",
      "nodes": [
        {
          "id": "courtyard_unsearched",
          "label": "Dziedziniec czeka na dokładne oględziny",
          "active_when": {
            "no_flags": ["courtyard_searched"]
          }
        },
        {
          "id": "courtyard_searched",
          "label": "Najważniejsze ślady na dziedzińcu zostały odnalezione",
          "active_when": {
            "all_flags": ["courtyard_searched"]
          },
          "terminal": true
        }
      ],
      "transitions": [
        {
          "id": "survey_courtyard",
          "goal_id": "survey_courtyard",
          "from": ["courtyard_unsearched"],
          "route_kind": "challenge_option",
          "route_ref": "inspect_tracks_courtyard"
        }
      ]
    },
    {
      "id": "wounded_scout_flow",
      "npc_id": "wounded_scout",
      "nodes": [
        {
          "id": "scout_untrusted",
          "label": "Zwiadowca jest ranny i nie ufa drużynie",
          "active_when": {
            "no_flags": ["scout_trusts_party", "scout_dead"]
          }
        },
        {
          "id": "scout_trusted",
          "label": "Zwiadowca ufa drużynie",
          "active_when": {
            "all_flags": ["scout_trusts_party"],
            "no_flags": ["scout_dead"]
          }
        }
      ],
      "transitions": [
        {
          "id": "calm_wounded_scout",
          "goal_id": "calm_scout",
          "from": ["scout_untrusted"],
          "route_kind": "npc_intent",
          "route_ref": "social"
        },
        {
          "id": "help_wounded_scout",
          "goal_id": "help_scout",
          "from": ["scout_untrusted", "scout_trusted"],
          "route_kind": "npc_intent",
          "route_ref": "medical"
        },
        {
          "id": "question_wounded_scout",
          "goal_id": "ask_scout",
          "from": ["scout_trusted"],
          "route_kind": "npc_intent",
          "route_ref": "information"
        },
        {
          "id": "pressure_wounded_scout",
          "goal_id": "pressure_scout",
          "from": ["scout_untrusted", "scout_trusted"],
          "route_kind": "npc_intent",
          "route_ref": "intimidation"
        }
      ]
    }
  ]
}
