                                                "odran_seal_seen",
                                                "chapel_tracks_read"
                                            ]
                                        },
                                        "text": "Krypta cichnie. Serai przyjmuje dowody i pozwala wam mowic przy relikwiarzu bez gniewu duchow.",
                                        "effects": [
                                            {
                                                "type": "set_flag",
                                                "flag": "serai_accepts_truth"
                                            }
                                        ]
                                    },
                                    {
                                        "id": "leave",
                                        "label": "Zakoncz rozmowe."
                                    }
                                ]
                            }
                        }
                    }
                },
                {
