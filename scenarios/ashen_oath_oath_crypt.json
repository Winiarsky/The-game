                        "enable_pickpocket": false,
                        "enable_diplomacy": false,
                        "dialog": {
                            "start": {
                                "title": "Serai, Warden of the Oath",
                                "text": "Serai jest bardziej wspomnieniem niz osoba. Jej glos brzmi spod kamienia: 'Przysiega nie chroni relikwiarza. Relikwiarz przypomina, komu przysiega sluzy.'",
                                "options": [
                                    {
                                        "id": "ask_oath",
                                        "label": "Zapytaj, co trzeba odnowic.",
                                        "text": "Serai odpowiada, ze trzeba nazwac prawde przy relikwiarzu: kto go wyniosl, kto zostal obwiniony i czy wioska ma dalej skladac przysiege strachowi."
                                    },
                                    {
                                        "id": "present_truth",
                                        "label": "Przedstaw dowody przeciw Odranowi.",
