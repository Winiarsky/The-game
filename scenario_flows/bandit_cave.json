{
    "format": "scenario_flow_v1",
    "scenario_id": "bandit_cave",
    "label": "Bandit Cave",
    "description": "Pierwszy referencyjny scenariusz wielomapowy: jaskinia bandytów, skarbiec i podziemne doki.",
    "entry_map_id": "cave_entrance",
    "maps": [
        {
            "map_id": "cave_entrance",
            "source_type": "runtime",
            "source": "bandit_cave_cave_entrance",
            "label": "Cave Entrance"
        },
        {
            "map_id": "treasure_room",
            "source_type": "runtime",
            "source": "bandit_cave_treasure_room",
            "label": "Treasure Room"
        },
        {
            "map_id": "smuggler_docks",
            "source_type": "runtime",
            "source": "bandit_cave_smuggler_docks",
            "label": "Smuggler Docks"
        }
    ],
    "transitions": [
        {
            "id": "cave_to_treasure",
            "from_map_id": "cave_entrance",
            "exit_id": "secret_treasure",
            "to_map_id": "treasure_room",
            "target_entry_anchor_id": "from_cave_secret",
            "conditions": [
                {"type": "flag", "flag": "secret_passage_found", "value": true}
            ]
        },
        {
            "id": "treasure_to_cave",
            "from_map_id": "treasure_room",
            "exit_id": "return_to_cave",
            "to_map_id": "cave_entrance",
            "target_entry_anchor_id": "secret_return",
            "conditions": []
        },
        {
            "id": "cave_to_docks",
            "from_map_id": "cave_entrance",
            "exit_id": "to_docks",
            "to_map_id": "smuggler_docks",
            "target_entry_anchor_id": "from_cave_docks",
            "conditions": []
        },
        {
            "id": "docks_to_cave",
            "from_map_id": "smuggler_docks",
            "exit_id": "return_to_cave_docks",
            "to_map_id": "cave_entrance",
            "target_entry_anchor_id": "docks_return",
            "conditions": []
        }
    ],
    "global_flags": {
        "secret_passage_found": false,
        "treasure_room_entered": false,
        "docks_cleared": false,
        "ship_escaped": false,
        "upper_cache_revealed": false,
        "upper_cache_revealed_by_marek": false,
        "dock_prisoner_freed": false,
        "dock_prisoner_cooperative": false,
        "dock_prisoner_escape_attempt": false,
        "dock_prisoner_escape_stopped": false,
        "dock_prisoner_loose": false,
        "docks_stealth_challenge_resolved": false,
        "docks_stealth_all_success": false,
        "docks_stealth_critical_failure": false
    },
    "events": [
        {
            "id": "cave_intro",
            "trigger": "map_start",
            "map_id": "cave_entrance",
            "once": true,
            "conditions": [],
            "actions": [
                {
                    "type": "show_prompt",
                    "message": "Stoisz przed wejściem do jaskini bandytów. Głębiej słyszysz ruch i szczekanie psa."
                }
            ]
        },
        {
            "id": "secret_discovered",
            "trigger": "object_revealed",
            "map_id": "cave_entrance",
            "target_id": "secret_treasure",
            "once": true,
            "conditions": [],
            "actions": [
                {
                    "type": "set_flag",
                    "flag": "secret_passage_found",
                    "value": true
                },
                {
                    "type": "complete_objective",
                    "objective_id": "find_secret_passage"
                },
                {
                    "type": "show_prompt",
                    "message": "Sekretne przejście do skarbca zostało odkryte. Bandyci najwyraźniej ukrywali tam coś cennego."
                },
                {
                    "type": "checkpoint",
                    "reason": "secret_passage_found"
                }
            ]
        },
        {
            "id": "cave_cleared",
            "trigger": "combat_end",
            "map_id": "cave_entrance",
            "once": true,
            "conditions": [
                {
                    "type": "map_enemies_cleared",
                    "map_id": "cave_entrance",
                    "value": true
                }
            ],
            "actions": [
                {
                    "type": "show_log",
                    "message": "Główna sala jaskini została oczyszczona. Możesz bezpieczniej przeszukać ukryte zakamarki albo zejść do doków."
                },
                {
                    "type": "checkpoint",
                    "reason": "cave_cleared"
                }
            ]
        },
        {
            "id": "treasure_intro",
            "trigger": "map_start",
            "map_id": "treasure_room",
            "once": true,
            "conditions": [],
            "actions": [
                {
                    "type": "set_flag",
                    "flag": "treasure_room_entered",
                    "value": true
                },
                {
                    "type": "show_prompt",
                    "message": "W skarbcu stoją skrzynie, zapasy kontrabandy i księgi rachunkowe. Coś tu wygląda na zabezpieczone pułapką."
                },
                {
                    "type": "checkpoint",
                    "reason": "treasure_room_entered"
                }
            ]
        },
        {
            "id": "reach_docks_objective",
            "trigger": "exit_enter",
            "map_id": "cave_entrance",
            "target_id": "to_docks",
            "once": true,
            "conditions": [],
            "actions": [
                {
                    "type": "complete_objective",
                    "objective_id": "reach_smuggler_docks"
                }
            ]
        },
        {
            "id": "docks_intro",
            "trigger": "map_start",
            "map_id": "smuggler_docks",
            "once": true,
            "conditions": [],
            "actions": [
                {
                    "type": "show_prompt",
                    "message": "Schodzisz do podziemnych doków. Przy nabrzeżu stoi łódź gotowa do odpłynięcia z kontrabandą."
                }
            ]
        },
        {
            "id": "docks_cleared",
            "trigger": "combat_end",
            "map_id": "smuggler_docks",
            "once": true,
            "conditions": [
                {
                    "type": "map_enemies_cleared",
                    "map_id": "smuggler_docks",
                    "value": true
                }
            ],
            "actions": [
                {
                    "type": "set_flag",
                    "flag": "docks_cleared",
                    "value": true
                },
                {
                    "type": "complete_objective",
                    "objective_id": "clear_smuggler_docks"
                },
                {
                    "type": "show_prompt",
                    "message": "Ostatni strażnicy doków padli. Statek przemytników stoi bez załogi i można go przejąć."
                },
                {
                    "type": "checkpoint",
                    "reason": "docks_cleared"
                }
            ]
        },
        {
            "id": "escape_by_ship",
            "trigger": "exit_interact",
            "map_id": "smuggler_docks",
            "target_id": "escape_ship",
            "once": true,
            "conditions": [
                {
                    "type": "flag",
                    "flag": "docks_cleared",
                    "value": true
                }
            ],
            "actions": [
                {
                    "type": "set_flag",
                    "flag": "ship_escaped",
                    "value": true
                },
                {
                    "type": "show_prompt",
                    "message": "Dok jest oczyszczony. Odbijasz od brzegu statkiem przemytników i kończysz scenariusz."
                },
                {
                    "type": "complete_objective",
                    "objective_id": "escape_on_ship"
                },
                {
                    "type": "finish_scenario"
                }
            ]
        }
    ],
    "objectives": [
        {
            "id": "find_secret_passage",
            "label": "Odkryj sekretne przejście",
            "description": "Przeszukaj jaskinię i znajdź ukryty dostęp do bandyckiego skarbca."
        },
        {
            "id": "reach_smuggler_docks",
            "label": "Dotrzyj do podziemnych doków",
            "description": "Przejdź przez główny tunel prowadzący z jaskini bandytów do doków."
        },
        {
            "id": "clear_smuggler_docks",
            "label": "Oczyść doki",
            "description": "Pokonaj strażników pilnujących łodzi i magazynu kontrabandy."
        },
        {
            "id": "escape_on_ship",
            "label": "Ucieknij statkiem przemytników",
            "description": "Oczyść dok i użyj łodzi do zakończenia scenariusza."
        }
    ],
    "checkpoint_policy": {
        "transition": "auto"
    }
}
