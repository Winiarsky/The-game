    "events": [
        {
            "id": "square_intro",
            "trigger": "map_start",
            "map_id": "brindleford_square",
            "once": true,
            "conditions": [],
            "actions": [
                {
                    "type": "show_prompt",
                    "title": "Briefing mapy: Rynek Brindleford",
                    "summary": "Cel: zdobyć pierwsze tropy i przygotować ludzi, zanim odważycie się przemówić publicznie.",
                    "prompt_id": "ashen_oath.map_briefing.brindleford_square",
                    "audio": "audio/voiceover/square_intro_001.mp3",
                    "message": "Po ustawieniu figurek widzicie Rynek Brindleford: pozornie pusty, ale nie martwy. Ludzie stoją w progach i za okiennicami, przygnębieni, zmęczeni i wyraźnie przestraszeni tym, że patrol Odrana słucha każdego słowa. Jeśli zapytacie ich osobno, część może powiedzieć prawdę. Jeśli spróbujecie przemówić do całego rynku, możecie przełamać strach naraz, ale to trudne i ryzykowne: nieprzygotowany tłum łatwo cofnie się w milczenie, a Odran obróci wasze słowa przeciwko wam. Zanim wejdziecie na środek placu, warto pomóc mieszkańcom, odczytać ślady przy studni, znaleźć bezpieczny punkt rozmowy przy piecu, rozpoznać rytm patrolu i sprawdzić kapliczkę. Te miejsca nie mówią graczom, co robić; dają ludziom powód, żeby w ogóle odważyli się odpowiedzieć."
                }
            ]
        },
        {
            "id": "ashen_mark_revealed",
            "trigger": "object_revealed",
            "map_id": "brindleford_square",
            "target_id": "ashen_oath_mark",
            "once": true,
            "conditions": [],
            "actions": [
                {"type": "set_flag", "flag": "castellan_doubted", "value": true},
                {
                    "type": "show_prompt",
                    "audio": "audio/voiceover/ashen_mark_revealed_001.mp3",
                    "message": "Pod warstwa popiolu przy studni widac znak wypalony w kamieniu: otwarta dlon nad plomieniem. To nie jest ostrzezenie przed klatwa. To znak straznikow."
                },
                {"type": "checkpoint", "reason": "ashen_mark_revealed"}
            ]
        },
        {
            "id": "chapel_intro",
            "trigger": "map_start",
            "map_id": "burned_chapel",
            "once": true,
            "conditions": [],
            "actions": [
                {
                    "type": "show_prompt",
                    "title": "Briefing mapy: Spalona Kaplica",
                    "summary": "Cel: zablokować ołtarz i dopiero potem pokonać Spalonego Diakona.",
                    "prompt_id": "ashen_oath.map_briefing.burned_chapel",
                    "audio": "audio/voiceover/chapel_intro_001.mp3",
                    "message": "Kaplica nie spłonęła jak budynek trafiony ogniem. Ściany stoją, dach częściowo trzyma się belek, ale wnętrze jest czarne, jakby płomień narodził się przy ołtarzu. Po ustawieniu planszy zwróćcie uwagę na zimne światło konfesjonału, cztery posągi i spaloną belkę blokującą krótszą drogę przez gruz. Ołtarz jest kotwicą rytuału. Jeśli obudzi się Spalony Diakon, nie wystarczy zbić mu punkty życia: najpierw musicie zebrać seal progress, maksymalnie raz na rundę, i zgasić to, co podtrzymuje go przy życiu."
                },
                {"type": "checkpoint", "reason": "burned_chapel_entered"}
            ]
        },
        {
