            "once": true,
            "conditions": [],
            "actions": [
                {
                    "type": "show_prompt",
                    "title": "Briefing mapy: Stary Młyn",
                    "summary": "Cel: uratować Tovina, zabezpieczyć dowody i nie dopuścić do alarmu.",
                    "prompt_id": "ashen_oath.map_briefing.old_mill",
                    "audio": "audio/voiceover/mill_intro_001.mp3",
                    "message": "Stary Młyn skrzypi bez wiatru. Koło obraca się powoli, mechanizm stuka zbyt równo, a zimny blask przy workach zdradza coś więcej niż zwykłą mąkę. Po setupie widać kilka celów naraz: Tovina, worki fałszywego popiołu, księgę młyna, mechanizm i tylny trakt. To mapa ratunkowo-śledcza, nie zwykłe czyszczenie przeciwników. Jeśli narobicie hałasu, alarm wzrośnie: strażnicy mogą niszczyć dowody, zagrozić zakładnikowi albo wysłać ostrzeżenie do Odrana. Ratujcie Tovina, ale nie traćcie z oczu tego, co może udowodnić kłamstwo."
                },
                {"type": "checkpoint", "reason": "old_mill_entered"}
