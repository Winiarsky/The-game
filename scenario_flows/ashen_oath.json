                    "map_id": "burned_chapel",
                    "target_id": "broken_oath_seal",
                    "message": "Gdy oltarz gasnie, pod kamieniem widac medalion Serai, peknieta pieczec Vale'a i fiolke jasnego popiolu."
                },
                {
                    "type": "show_prompt",
                    "audio": "audio/voiceover/charred_deacon_defeated_001.mp3",
                    "message": "Spalony Diakon rozpada sie bez powrotu. Jego ostatni szept nie oskarza Miry. Powtarza tylko jedno slowo: milczenie."
                },
                {"type": "checkpoint", "reason": "charred_deacon_defeated"}
            ]
        },
